# Copier en .env (jamais commité) puis renseigner.
# Source de données : "mock" (données fictives, par défaut) ou "fabric" (Lakehouse).
APP_DATA_SOURCE=mock
# SQL analytics endpoint du Lakehouse LKH_RFPTeam_Bronze (authentification Entra ID interactive)
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=
# Client SQL : mssql-python (défaut, rien à installer hors pip) ou pyodbc (pilote ODBC 18 requis)
# FABRIC_CLIENT=mssql-python
# FABRIC_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Délais en secondes : connexion (fenêtre Microsoft comprise) et requête
# FABRIC_LOGIN_TIMEOUT=120
# FABRIC_QUERY_TIMEOUT=600
# Environnement Python à réutiliser (sinon %USERPROFILE%\venv-rco s'il existe)
# RCO_VENV=C:\Users\<vous>\venv-rco
# APP_HISTORY_YEARS=4
# APP_STALE_DAYS=12

# Repérage des fonds Rothschild Martin Maurel (facultatif)
# APP_RMM_COLUMNS=Sponsoring_Entity,Investment_Manager,Owning_Business_Unit,Owning_Team,Fund_Range,Umbrella_Name,Product_Name
# APP_RMM_PATTERN=\bRMM\b|martin\s*maurel

# --- Passif (tables compte / position / transaction du Lakehouse, colonnes _c0…_cN) ---
# Noms des tables dans Fabric (par défaut : compte, position, transaction)
# APP_PASSIF_TABLE_COMPTE=compte
# APP_PASSIF_TABLE_POSITION=position
# APP_PASSIF_TABLE_TRANSACTION=transaction
# Correspondance exacte des colonnes (aucune devinette) : les vrais noms sont utilisés s'ils existent, sinon _c0…_cN dans
# l'ordre ci-dessous (valeurs par défaut, à n'ajuster que si la disposition change)
# APP_PASSIF_MAP_COMPTE=teneur=_c0,id_compte=_c1,nom_compte=_c2,id_parent=_c3,nom_parent=_c4,id_client=_c5,nom_client=_c6,classification=_c7,devise=_c8,date_creation=_c9,date_dissolution=_c10
# APP_PASSIF_MAP_POSITION=compte=_c3,isin=_c10,classe_actif=_c11,desk=_c12,date=_c13,quantite=_c14,cours=_c15,montant_devise=_c16,devise=_c17,montant_eur=_c18,dernier_trade=_c19,premier_trade=_c20
# APP_PASSIF_MAP_TRANSACTION=compte=_c3,isin=_c10,classe_actif=_c11,desk=_c12,date_centralisation=_c13,date_vl=_c14,date_valeur=_c15,sens=_c16,statut=_c17,devise=_c18,quantite=_c19,cours=_c20,montant_devise=_c21,montant_eur=_c22,centralisateur=_c24,reference=_c25,date_creation=_c26,compte_indirect=_c27
# Statuts d'opération retenus (les autres, annulé, en attente…, sont listés mais exclus)
# APP_PASSIF_STATUTS_AUTORISES=Valorisé,Clôturé / après cut-off
# Durée de validité des agrégats du passif en heures (tables mises à jour chaque jour)
# APP_PASSIF_TTL_HOURS=6
